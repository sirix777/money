{
    "name": "sirix/money",
    "description": "Immutable, framework-agnostic currency catalogs and money factories",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Sirix",
            "homepage": "https://github.com/sirix777"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "brick/math": "^0.18 || ^0.19",
        "brick/money": "^0.14.1"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.45",
        "phpbench/phpbench": "^1.4",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Sirix\\Money\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sirix\\Money\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "scripts": {
        "benchmark": "./vendor/bin/phpbench run test/Benchmark --report=default",
        "check": [
            "@cs-check",
            "@phpstan",
            "@test"
        ],
        "cs-check": "php tools/php-cs-fixer/vendor/bin/php-cs-fixer fix -vvv --dry-run --diff --sequential",
        "cs-fix": "php tools/php-cs-fixer/vendor/bin/php-cs-fixer fix -vvv --sequential",
        "phpstan": "php tools/phpstan/vendor/bin/phpstan --debug",
        "test": "phpunit --testdox --colors=always --fail-on-deprecation",
        "tools": [
            "composer install --working-dir=tools/phpstan --prefer-dist --no-progress",
            "composer install --working-dir=tools/php-cs-fixer --prefer-dist --no-progress"
        ]
    }
}
